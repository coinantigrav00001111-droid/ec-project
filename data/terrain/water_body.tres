[gd_resource type="Resource" script_class="EntitySetting" format=3]

[ext_resource type="Script" path="res://core/component_setting.gd" id="1_cs"]
[ext_resource type="Script" path="res://core/entity_setting.gd" id="2_es"]
[ext_resource type="Script" path="res://core/components/comp_settings/identity_setting.gd" id="3_id"]
[ext_resource type="Script" path="res://setting/object_config.gd" id="4_oc"]
[ext_resource type="Script" path="res://core/components/comp_settings/water_setting.gd" id="5_ws"]
[ext_resource type="Script" path="res://core/components/comp_settings/hoverable_setting.gd" id="6_hv"]
[ext_resource type="Script" path="res://core/components/comp_settings/selectable_setting.gd" id="7_sl"]

[sub_resource type="Resource" id="Resource_cfg"]
script = ExtResource("4_oc")

[sub_resource type="Resource" id="Resource_id"]
