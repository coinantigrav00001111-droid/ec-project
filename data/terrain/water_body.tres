[resource]
script = ExtResource("2_es")
key = &"terrain.water.body"
name = "water_body"
description = "Водный участок. Не кнопка каталога: создаётся инструментом «Налить воду» (лежит вне objects/, чтобы не попасть в каталог)"
category = &"terrain"
tag = &"water"
hide = true
components = Array[ExtResource("1_cs")]([SubResource("Resource_id"), SubResource("Resource_water"), SubResource("Resource_hov"), SubResource("Resource_sel")])
