; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EC_project"
config/version="0.6.0"
config/tags=PackedStringArray("actual")
run/main_scene="uid://csy3eqxdwo2lo"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/driver="Dummy"

[autoload]

Global="*uid://cuyqabojk5lbh"
PGM="*uid://cs6t1pamqjrbq"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg", "res://addons/fancy_folder_colors/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg")

